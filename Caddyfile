# Сайт и API на одном домене (pr-100): клиент ходит на /api/v1 без CORS,
# как в разработке через прокси Vite
{$SITE_ADDRESS} {
	encode zstd gzip

	# API и WebSocket предупреждений. /metrics, /healthz, /readyz наружу не
	# открываются: их опрашивают изнутри сети Docker
	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			# Сайт открывается только по https: браузер больше не пойдёт по http
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			# Камера и геолокация — только самому сайту (фото листа, обход
			# участка), микрофон и оплата не нужны
			Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=(), usb=()"
			# Политика содержимого. Скрипты — свои и SDK Telegram; inline —
			# заставка и выбор темы до загрузки приложения в index.html;
			# wasm-unsafe-eval — ONNX Runtime в браузере (диагностика без сети).
			# Тайлы карт и Sentry — внешние https-адреса. Вместо X-Frame-Options
			# — frame-ancestors: во фрейме сайт открывает только веб-версия Telegram
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; worker-src 'self' blob:; child-src 'self' blob:; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; object-src 'none'; base-uri 'self'; form-action 'self'"
		}
		# Файлы сборки с хэшем в имени не меняются — кэш на год
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Service Worker и страница проверяются при каждом заходе: иначе
		# новая версия сайта не дошла бы до пользователя
		@fresh path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
